{
  "name": "decky-mcp",
  "displayName": "Decky-MCP",
  "description": "Live screen, one-click deploy, logs and Steam console for Decky plugin development on devices running Decky Loader (Steam Deck, SteamOS, Bazzite)",
  "version": "0.6.0",
  "publisher": "jackhric",
  "icon": "media/icon.png",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackh/decky-mcp.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "decky",
    "steam deck",
    "steamos",
    "bazzite",
    "mcp"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:plugin.json",
    "workspaceContains:*/plugin.json",
    "workspaceContains:*/*/plugin.json",
    "onView:decky-mcp.devices",
    "onView:decky-mcp.actions",
    "onView:decky-mcp.plugins",
    "onView:decky-mcp.controllers",
    "onView:decky-mcp.preview"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "decky-mcp",
          "title": "Decky",
          "icon": "media/decky.svg"
        }
      ]
    },
    "views": {
      "decky-mcp": [
        {
          "id": "decky-mcp.devices",
          "name": "Devices",
          "icon": "media/decky.svg",
          "initialSize": 2
        },
        {
          "id": "decky-mcp.actions",
          "name": "Actions",
          "icon": "media/decky.svg",
          "when": "decky-mcp.connected",
          "initialSize": 6
        },
        {
          "id": "decky-mcp.plugins",
          "name": "Plugins",
          "icon": "media/decky.svg",
          "when": "decky-mcp.connected",
          "visibility": "collapsed",
          "initialSize": 2
        },
        {
          "id": "decky-mcp.controllers",
          "name": "Controllers",
          "icon": "media/decky.svg",
          "when": "decky-mcp.connected",
          "visibility": "collapsed",
          "initialSize": 2
        },
        {
          "type": "webview",
          "id": "decky-mcp.preview",
          "name": "Preview",
          "icon": "media/decky.svg",
          "when": "decky-mcp.connected",
          "initialSize": 1
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "decky-mcp.devices",
        "contents": "No devices yet. Add a Decky device (any machine running Decky Loader: Steam Deck, Bazzite, SteamOS, \u2026).\n[Add device](command:decky-mcp.addDevice)"
      },
      {
        "view": "decky-mcp.controllers",
        "contents": "No controllers seen by Steam Input.\n[Add virtual controller](command:decky-mcp.addVirtualController)"
      }
    ],
    "commands": [
      {
        "command": "decky-mcp.enterToken",
        "title": "Enter token manually",
        "category": "Decky",
        "icon": "$(key)"
      },
      {
        "command": "decky-mcp.disconnect",
        "title": "Disconnect and forget token",
        "category": "Decky",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "decky-mcp.openScreen",
        "title": "Open screen",
        "category": "Decky",
        "icon": "$(device-desktop)"
      },
      {
        "command": "decky-mcp.openViewer",
        "title": "Open viewer in browser",
        "category": "Decky",
        "icon": "$(link-external)"
      },
      {
        "command": "decky-mcp.snapshot",
        "title": "Snapshot to file",
        "category": "Decky",
        "icon": "$(device-camera)"
      },
      {
        "command": "decky-mcp.toggleInput",
        "title": "Toggle remote input",
        "category": "Decky",
        "icon": "$(keyboard)"
      },
      {
        "command": "decky-mcp.addVirtualController",
        "title": "Add virtual controller",
        "category": "Decky",
        "icon": "$(add)"
      },
      {
        "command": "decky-mcp.removeVirtualController",
        "title": "Remove virtual controller",
        "category": "Decky",
        "icon": "$(trash)"
      },
      {
        "command": "decky-mcp.refreshControllers",
        "title": "Refresh controllers",
        "category": "Decky",
        "icon": "$(refresh)"
      },
      {
        "command": "decky-mcp.navigate",
        "title": "Navigate Steam UI to\u2026",
        "category": "Decky",
        "icon": "$(compass)"
      },
      {
        "command": "decky-mcp.openPluginPanel",
        "title": "Open plugin panel\u2026",
        "category": "Decky",
        "icon": "$(extensions)"
      },
      {
        "command": "decky-mcp.uiBack",
        "title": "Steam UI: Back",
        "category": "Decky",
        "icon": "$(arrow-left)"
      },
      {
        "command": "decky-mcp.uiQuickAccess",
        "title": "Steam UI: Quick Access",
        "category": "Decky",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "decky-mcp.uiCloseMenus",
        "title": "Steam UI: Close menus",
        "category": "Decky",
        "icon": "$(close-all)"
      },
      {
        "command": "decky-mcp.deploy",
        "title": "Deploy plugin",
        "category": "Decky",
        "icon": "$(rocket)"
      },
      {
        "command": "decky-mcp.deployFull",
        "title": "Deploy plugin (full restart)",
        "category": "Decky",
        "icon": "$(debug-restart)"
      },
      {
        "command": "decky-mcp.toggleAutoDeploy",
        "title": "Toggle auto-deploy on change",
        "category": "Decky",
        "icon": "$(sync)"
      },
      {
        "command": "decky-mcp.restartLoader",
        "title": "Restart loader",
        "category": "Decky",
        "icon": "$(debug-restart)"
      },
      {
        "command": "decky-mcp.reloadPlugin",
        "title": "Reload plugin",
        "category": "Decky",
        "icon": "$(refresh)"
      },
      {
        "command": "decky-mcp.loaderLogs",
        "title": "Show loader logs",
        "category": "Decky",
        "icon": "$(output)"
      },
      {
        "command": "decky-mcp.pluginLogs",
        "title": "Show plugin logs",
        "category": "Decky",
        "icon": "$(output)"
      },
      {
        "command": "decky-mcp.evaluate",
        "title": "Evaluate JS in Steam UI",
        "category": "Decky"
      },
      {
        "command": "decky-mcp.toast",
        "title": "Toast on device",
        "category": "Decky"
      },
      {
        "command": "decky-mcp.writeMcpConfig",
        "title": "Write MCP config for this workspace",
        "category": "Decky"
      },
      {
        "command": "decky-mcp.copyMcpUrl",
        "title": "Copy MCP URL",
        "category": "Decky",
        "icon": "$(link)"
      },
      {
        "command": "decky-mcp.copyToken",
        "title": "Copy token",
        "category": "Decky",
        "icon": "$(key)"
      },
      {
        "command": "decky-mcp.refresh",
        "title": "Refresh",
        "category": "Decky",
        "icon": "$(refresh)"
      },
      {
        "command": "decky-mcp.refreshPlugins",
        "title": "Refresh plugins",
        "category": "Decky",
        "icon": "$(refresh)"
      },
      {
        "command": "decky-mcp.installZip",
        "title": "Install plugin zip\u2026",
        "category": "Decky",
        "icon": "$(package)"
      },
      {
        "command": "decky-mcp.changeHost",
        "title": "Change host",
        "category": "Decky",
        "icon": "$(server)"
      },
      {
        "command": "decky-mcp.addDevice",
        "title": "Add device\u2026",
        "category": "Decky",
        "icon": "$(add)"
      },
      {
        "command": "decky-mcp.editDevice",
        "title": "Edit device",
        "category": "Decky",
        "icon": "$(edit)"
      },
      {
        "command": "decky-mcp.removeDevice",
        "title": "Remove device",
        "category": "Decky",
        "icon": "$(trash)"
      },
      {
        "command": "decky-mcp.switchDevice",
        "title": "Switch device",
        "category": "Decky",
        "icon": "$(vm)"
      },
      {
        "command": "decky-mcp.connect",
        "title": "Connect",
        "category": "Decky",
        "icon": "$(plug)"
      },
      {
        "command": "decky-mcp.disconnectDevice",
        "title": "Disconnect",
        "category": "Decky",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "decky-mcp.pairAgain",
        "title": "Re-pair",
        "category": "Decky",
        "icon": "$(key)"
      },
      {
        "command": "decky-mcp.copyViewerUrl",
        "title": "Copy viewer URL",
        "category": "Decky",
        "icon": "$(copy)"
      },
      {
        "command": "decky-mcp.deviceActions",
        "title": "More actions\u2026",
        "category": "Decky",
        "icon": "$(ellipsis)"
      }
    ],
    "configuration": {
      "title": "Decky-MCP",
      "properties": {
        "decky-mcp.host": {
          "type": "string",
          "default": "10.0.70.18",
          "description": "IP address or hostname of the device running the Decky-MCP plugin."
        },
        "decky-mcp.port": {
          "type": "number",
          "default": 8765,
          "description": "Port of the Decky-MCP HTTP server."
        },
        "decky-mcp.pluginDirName": {
          "type": "string",
          "default": "",
          "description": "Directory name under ~/homebrew/plugins to deploy to. Empty means the workspace folder's name."
        },
        "decky-mcp.openScreenOnConnect": {
          "type": "boolean",
          "default": true,
          "description": "Open the live screen panel after the first successful connect of a session."
        },
        "decky-mcp.deploy.build": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Run the package.json build script only when src/ (or tsconfig/rollup config) is newer than dist/index.js",
            "Always run the build script before deploying",
            "Never build; deploy dist/ as it is"
          ],
          "default": "auto",
          "description": "Whether Deploy runs `pnpm run build` (or npm/yarn, from the lockfile) first. Python files never need a build."
        },
        "decky-mcp.deploy.onChange": {
          "type": "boolean",
          "default": false,
          "description": "Deploy the workspace plugin (fast, without building) whenever dist/index.js, main.py or py_modules/**/*.py change. Keep your build running in watch mode (`pnpm run watch`)."
        }
      }
    },
    "keybindings": [
      {
        "command": "decky-mcp.deploy",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "decky-mcp.addDevice",
          "when": "view == decky-mcp.devices",
          "group": "navigation@1"
        },
        {
          "command": "decky-mcp.refresh",
          "when": "view == decky-mcp.devices",
          "group": "navigation@2"
        },
        {
          "command": "decky-mcp.openScreen",
          "when": "view == decky-mcp.actions",
          "group": "navigation@1"
        },
        {
          "command": "decky-mcp.refresh",
          "when": "view == decky-mcp.actions",
          "group": "navigation@2"
        },
        {
          "command": "decky-mcp.installZip",
          "when": "view == decky-mcp.plugins",
          "group": "navigation@1"
        },
        {
          "command": "decky-mcp.refreshPlugins",
          "when": "view == decky-mcp.plugins",
          "group": "navigation@2"
        },
        {
          "command": "decky-mcp.addVirtualController",
          "when": "view == decky-mcp.controllers",
          "group": "navigation@1"
        },
        {
          "command": "decky-mcp.refreshControllers",
          "when": "view == decky-mcp.controllers",
          "group": "navigation@2"
        },
        {
          "command": "decky-mcp.openScreen",
          "when": "view == decky-mcp.preview",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "decky-mcp.reloadPlugin",
          "when": "view == decky-mcp.plugins && viewItem == plugin",
          "group": "inline@1"
        },
        {
          "command": "decky-mcp.pluginLogs",
          "when": "view == decky-mcp.plugins && viewItem == plugin",
          "group": "inline@2"
        },
        {
          "command": "decky-mcp.reloadPlugin",
          "when": "view == decky-mcp.plugins && viewItem == plugin",
          "group": "1_plugin@1"
        },
        {
          "command": "decky-mcp.pluginLogs",
          "when": "view == decky-mcp.plugins && viewItem == plugin",
          "group": "1_plugin@2"
        },
        {
          "command": "decky-mcp.openPluginPanel",
          "when": "view == decky-mcp.plugins && viewItem == plugin",
          "group": "1_plugin@3"
        },
        {
          "command": "decky-mcp.removeVirtualController",
          "when": "view == decky-mcp.controllers && viewItem == controller.virtual",
          "group": "inline@1"
        },
        {
          "command": "decky-mcp.removeVirtualController",
          "when": "view == decky-mcp.controllers && viewItem == controller.virtual",
          "group": "1_controller@1"
        },
        {
          "command": "decky-mcp.connect",
          "when": "view == decky-mcp.devices && viewItem =~ /^deck\\.(unpaired|paired)$/",
          "group": "inline@1"
        },
        {
          "command": "decky-mcp.disconnectDevice",
          "when": "view == decky-mcp.devices && viewItem == deck.session",
          "group": "inline@1"
        },
        {
          "command": "decky-mcp.deviceActions",
          "when": "view == decky-mcp.devices && viewItem =~ /^deck\\.(unpaired|paired|session)$/",
          "group": "inline@2"
        },
        {
          "command": "decky-mcp.connect",
          "when": "view == decky-mcp.devices && viewItem =~ /^deck\\.(unpaired|paired)$/",
          "group": "1_connect@1"
        },
        {
          "command": "decky-mcp.disconnectDevice",
          "when": "view == decky-mcp.devices && viewItem == deck.session",
          "group": "1_connect@1"
        },
        {
          "command": "decky-mcp.pairAgain",
          "when": "view == decky-mcp.devices && viewItem =~ /^deck\\.(paired|session)$/",
          "group": "2_pair@1"
        },
        {
          "command": "decky-mcp.enterToken",
          "when": "view == decky-mcp.devices && viewItem =~ /^deck\\.(unpaired|paired|session)$/",
          "group": "2_pair@2"
        },
        {
          "command": "decky-mcp.editDevice",
          "when": "view == decky-mcp.devices && viewItem =~ /^deck\\.(unpaired|paired|session)$/",
          "group": "3_device@1"
        },
        {
          "command": "decky-mcp.copyViewerUrl",
          "when": "view == decky-mcp.devices && viewItem =~ /^deck\\./",
          "group": "3_device@2"
        },
        {
          "command": "decky-mcp.removeDevice",
          "when": "view == decky-mcp.devices && viewItem =~ /^deck\\.(unpaired|paired|session)$/",
          "group": "3_device@3"
        }
      ],
      "commandPalette": [
        {
          "command": "decky-mcp.deviceActions",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "smoke": "node scripts/smoke.mjs",
    "dev-check": "node scripts/dev-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
