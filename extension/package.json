      {
        "view": "decky-toolkit.plugins",
        "contents": "The device no longer accepts this editor, so nothing can be loaded. Reconnect, then approve this editor on the device.\n[Reconnect](command:decky-toolkit.reconnect)",
        "when": "decky-toolkit.link == rejected"
