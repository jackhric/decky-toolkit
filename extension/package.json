    "configuration": {
      "title": "Decky Toolkit",
      "properties": {
        "decky-toolkit.host": {
          "type": "string",
          "default": "",
          "description": "IP address or hostname of the device running the Decky Toolkit plugin."
        },
        "decky-toolkit.port": {
          "type": "number",
          "default": 8765,
          "description": "Port of the Decky Toolkit HTTP server."
        },
        "decky-toolkit.mcpPort": {
          "type": "number",
          "default": 8766,
          "minimum": 1024,
          "maximum": 65535,
          "description": "Local port MCP clients (Claude Code etc.) connect to; the extension relays their requests to the connected device. When another VS Code window already uses it, the next free port is taken. Takes effect after a window reload."
        },
        "decky-toolkit.pluginDirName": {
          "type": "string",
          "default": "",
          "description": "Directory name under ~/homebrew/plugins for the first install. Empty means the plugin folder's name. A plugin the device already has under the same plugin.json name is updated in its own directory."
        },
        "decky-toolkit.openScreenOnConnect": {
          "type": "boolean",
          "default": true,
          "description": "Open the live screen panel after the first successful connect of a session."
        },
        "decky-toolkit.deploy.build": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Run the package.json build script only when src/ (or tsconfig/rollup config) is newer than dist/index.js",
            "Always run the build script before deploying",
            "Never build; deploy dist/ as it is"
          ],
          "default": "auto",
          "description": "Whether Deploy runs `pnpm run build` (or npm/yarn, from the lockfile) first. Python files never need a build."
        },
        "decky-toolkit.deploy.onChange": {
          "type": "boolean",
          "default": false,
          "description": "Keep the device in step with the workspace plugin. The first change to dist/, py_modules/, assets/, defaults/, main.py or the manifests deploys it; after that (devices with live sync) changed files are pushed and the plugin reloads in place: a bundle change re-imports only the frontend, a Python change restarts the backend, a plugin.json or package.json change deploys again."
        },
        "decky-toolkit.deploy.watchBuild": {
          "type": "boolean",
          "default": true,
          "description": "While auto-deploy on change is on, run the plugin's package.json \"watch\" script (vite, rollup, ...) in the background, with its output in the Decky Toolkit output channel."
        },
        "decky-toolkit.discovery.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Search the local network for Decky Toolkit devices that are not saved yet (mDNS plus a probe of this machine's own subnets, like Moonlight). Runs when the Devices view opens and on Search network, never in the background. Devices on other subnets are not found; add them by address."
        }
      }
    },
    "keybindings": [
      {
        "command": "decky-toolkit.deploy",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
