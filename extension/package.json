{
  "name": "decky-toolkit",
  "displayName": "Decky Toolkit",
  "description": "Build, deploy and live reload Decky Loader plugins on Steam Deck, SteamOS and Bazzite from VS Code.",
  "version": "0.10.0",
  "publisher": "jackhric",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackhric/decky-toolkit.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "decky",
    "decky loader",
    "decky plugin",
    "steam deck",
    "steamdeck",
    "steamos",
    "bazzite",
    "homebrew",
    "plugin development",
    "live reload",
    "deploy",
    "cef",
    "devtools",
    "remote debugging",
    "gamescope",
    "quick access",
    "mcp",
    "claude code"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:plugin.json",
    "workspaceContains:*/plugin.json",
    "workspaceContains:*/*/plugin.json",
    "onView:decky-toolkit.welcome",
    "onView:decky-toolkit.devices",
    "onView:decky-toolkit.actions",
    "onView:decky-toolkit.plugins",
    "onView:decky-toolkit.games",
    "onView:decky-toolkit.controllers",
    "onView:decky-toolkit.preview",
    "onFileSystem:decky"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "decky-toolkit",
          "title": "Decky",
          "icon": "media/decky.svg"
        }
      ]
    },
    "views": {
      "decky-toolkit": [
        {
          "type": "webview",
          "id": "decky-toolkit.welcome",
          "name": "Devices",
          "icon": "media/decky.svg",
          "when": "!decky-toolkit.hasDevices",
          "initialSize": 2
        },
        {
          "id": "decky-toolkit.devices",
          "name": "Devices",
          "icon": "media/decky.svg",
          "initialSize": 2,
          "when": "decky-toolkit.hasDevices"
        },
        {
          "id": "decky-toolkit.actions",
          "name": "Actions",
          "icon": "media/decky.svg",
          "when": "decky-toolkit.link",
          "initialSize": 6
        },
        {
          "id": "decky-toolkit.plugins",
          "name": "Plugins",
          "icon": "media/decky.svg",
          "when": "decky-toolkit.link",
          "visibility": "collapsed",
          "initialSize": 2
        },
        {
          "id": "decky-toolkit.games",
          "name": "Games",
          "icon": "media/decky.svg",
          "when": "decky-toolkit.link",
          "visibility": "collapsed",
          "initialSize": 3
        },
        {
          "id": "decky-toolkit.controllers",
          "name": "Controllers",
          "icon": "media/decky.svg",
          "when": "decky-toolkit.link",
          "visibility": "collapsed",
          "initialSize": 2
        },
        {
          "type": "webview",
          "id": "decky-toolkit.preview",
          "name": "Preview",
          "icon": "media/decky.svg",
          "when": "decky-toolkit.link",
          "initialSize": 1
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "decky-toolkit.controllers",
        "contents": "No controllers seen by Steam Input.\n[Add virtual controller](command:decky-toolkit.addVirtualController)",
        "when": "decky-toolkit.link == connected"
      },
      {
        "view": "decky-toolkit.actions",
        "contents": "Connecting to the device…",
        "when": "decky-toolkit.link == connecting"
      },
      {
        "view": "decky-toolkit.actions",
        "contents": "Lost connection to the device. It is not answering; this view fills again as soon as it does.\n[Reconnect now](command:decky-toolkit.reconnect)",
        "when": "decky-toolkit.link == unreachable"
      },
      {
        "view": "decky-toolkit.actions",
        "contents": "The device no longer accepts this editor, so nothing can be loaded. Reconnect, then approve this editor on the device.\n[Reconnect](command:decky-toolkit.reconnect)",
        "when": "decky-toolkit.link == rejected"
      },
      {
        "view": "decky-toolkit.actions",
        "contents": "Disconnected from the device.\n[Reconnect](command:decky-toolkit.reconnect)",
        "when": "decky-toolkit.link == disconnected"
      },
      {
        "view": "decky-toolkit.plugins",
        "contents": "Connecting to the device…",
        "when": "decky-toolkit.link == connecting"
      },
      {
        "view": "decky-toolkit.plugins",
