{
  "name": "decky-toolkit",
  "displayName": "Decky Toolkit",
  "description": "Decky Loader plugin development for VS Code.",
  "version": "0.6.4",
  "publisher": "jackhric",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackhric/decky-toolkit.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "decky",
    "steam deck",
    "steamos",
    "bazzite",
    "mcp"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:plugin.json",
    "workspaceContains:*/plugin.json",
    "workspaceContains:*/*/plugin.json",
    "onView:decky-toolkit.devices",
    "onView:decky-toolkit.actions",
    "onView:decky-toolkit.plugins",
    "onView:decky-toolkit.controllers",
    "onView:decky-toolkit.preview"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "decky-toolkit",
          "title": "Decky",
          "icon": "media/decky.svg"
        }
      ]
    },
    "views": {
      "decky-toolkit": [
        {
          "id": "decky-toolkit.devices",
          "name": "Devices",
          "icon": "media/decky.svg",
          "initialSize": 2
        },
        {
          "id": "decky-toolkit.actions",
          "name": "Actions",
          "icon": "media/decky.svg",
          "when": "decky-toolkit.connected",
          "initialSize": 6
        },
        {
          "id": "decky-toolkit.plugins",
          "name": "Plugins",
          "icon": "media/decky.svg",
          "when": "decky-toolkit.connected",
          "visibility": "collapsed",
          "initialSize": 2
        },
        {
          "id": "decky-toolkit.controllers",
          "name": "Controllers",
          "icon": "media/decky.svg",
          "when": "decky-toolkit.connected",
          "visibility": "collapsed",
          "initialSize": 2
        },
        {
          "type": "webview",
          "id": "decky-toolkit.preview",
          "name": "Preview",
          "icon": "media/decky.svg",
          "when": "decky-toolkit.connected",
          "initialSize": 1
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "decky-toolkit.devices",
        "contents": "No devices yet. Add a Decky device (any machine running Decky Loader: Steam Deck, Bazzite, SteamOS, …).\n[Add device](command:decky-toolkit.addDevice)"
      },
      {
        "view": "decky-toolkit.controllers",
        "contents": "No controllers seen by Steam Input.\n[Add virtual controller](command:decky-toolkit.addVirtualController)"
      }
    ],
    "commands": [
      {
        "command": "decky-toolkit.enterToken",
        "title": "Enter token manually",
        "category": "Decky",
        "icon": "$(key)"
      },
      {
        "command": "decky-toolkit.disconnect",
        "title": "Disconnect and forget token",
        "category": "Decky",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "decky-toolkit.openScreen",
        "title": "Open screen",
        "category": "Decky",
        "icon": "$(device-desktop)"
      },
      {
        "command": "decky-toolkit.openViewer",
        "title": "Open viewer in browser",
        "category": "Decky",
        "icon": "$(link-external)"
      },
      {
        "command": "decky-toolkit.snapshot",
        "title": "Snapshot to file",
        "category": "Decky",
        "icon": "$(device-camera)"
      },
      {
        "command": "decky-toolkit.toggleInput",
        "title": "Toggle remote input",
        "category": "Decky",
        "icon": "$(keyboard)"
      },
      {
        "command": "decky-toolkit.addVirtualController",
        "title": "Add virtual controller",
        "category": "Decky",
        "icon": "$(add)"
      },
      {
        "command": "decky-toolkit.removeVirtualController",
        "title": "Remove virtual controller",
        "category": "Decky",
        "icon": "$(trash)"
      },
      {
        "command": "decky-toolkit.refreshControllers",
        "title": "Refresh controllers",
        "category": "Decky",
        "icon": "$(refresh)"
      },
      {
        "command": "decky-toolkit.navigate",
        "title": "Navigate Steam UI to…",
        "category": "Decky",
        "icon": "$(compass)"
      },
      {
        "command": "decky-toolkit.openPluginPanel",
        "title": "Open plugin panel…",
        "category": "Decky",
        "icon": "$(extensions)"
      },
      {
        "command": "decky-toolkit.uiBack",
        "title": "Steam UI: Back",
        "category": "Decky",
        "icon": "$(arrow-left)"
      },
      {
        "command": "decky-toolkit.uiQuickAccess",
        "title": "Steam UI: Quick Access",
        "category": "Decky",
        "icon": "$(layout-sidebar-right)"
      },
      {
        "command": "decky-toolkit.uiCloseMenus",
        "title": "Steam UI: Close menus",
        "category": "Decky",
        "icon": "$(close-all)"
      },
      {
        "command": "decky-toolkit.deploy",
        "title": "Deploy plugin",
        "category": "Decky",
        "icon": "$(rocket)"
      },
      {
        "command": "decky-toolkit.deployFull",
        "title": "Deploy plugin (full restart)",
        "category": "Decky",
        "icon": "$(debug-restart)"
      },
      {
        "command": "decky-toolkit.toggleAutoDeploy",
        "title": "Toggle auto-deploy on change",
        "category": "Decky",
        "icon": "$(sync)"
      },
      {
        "command": "decky-toolkit.restartLoader",
        "title": "Restart loader",
        "category": "Decky",
        "icon": "$(debug-restart)"
      },
      {
        "command": "decky-toolkit.updateToolkit",
        "title": "Update Decky Toolkit on device",
        "category": "Decky",
        "icon": "$(cloud-download)"
      },
      {
        "command": "decky-toolkit.reloadPlugin",
        "title": "Reload plugin",
        "category": "Decky",
        "icon": "$(refresh)"
      },
      {
        "command": "decky-toolkit.loaderLogs",
        "title": "Show loader logs",
        "category": "Decky",
        "icon": "$(output)"
      },
      {
        "command": "decky-toolkit.pluginLogs",
        "title": "Show plugin logs",
        "category": "Decky",
        "icon": "$(output)"
      },
      {
        "command": "decky-toolkit.evaluate",
        "title": "Evaluate JS in Steam UI",
        "category": "Decky"
      },
      {
        "command": "decky-toolkit.toast",
        "title": "Toast on device",
        "category": "Decky"
      },
      {
        "command": "decky-toolkit.writeMcpConfig",
        "title": "Write MCP config for this workspace",
        "category": "Decky"
      },
      {
        "command": "decky-toolkit.copyMcpUrl",
        "title": "Copy MCP URL",
        "category": "Decky",
        "icon": "$(link)"
      },
      {
        "command": "decky-toolkit.copyToken",
        "title": "Copy token",
        "category": "Decky",
        "icon": "$(key)"
      },
      {
        "command": "decky-toolkit.refresh",
        "title": "Refresh",
        "category": "Decky",
        "icon": "$(refresh)"
      },
      {
        "command": "decky-toolkit.refreshPlugins",
        "title": "Refresh plugins",
        "category": "Decky",
        "icon": "$(refresh)"
      },
      {
        "command": "decky-toolkit.installZip",
        "title": "Install plugin zip…",
        "category": "Decky",
        "icon": "$(package)"
      },
      {
        "command": "decky-toolkit.changeHost",
        "title": "Change host",
        "category": "Decky",
        "icon": "$(server)"
      },
      {
        "command": "decky-toolkit.addDevice",
        "title": "Add device…",
        "category": "Decky",
        "icon": "$(add)"
      },
      {
        "command": "decky-toolkit.editDevice",
        "title": "Edit device",
        "category": "Decky",
        "icon": "$(edit)"
      },
      {
        "command": "decky-toolkit.removeDevice",
        "title": "Remove device",
        "category": "Decky",
        "icon": "$(trash)"
      },
      {
        "command": "decky-toolkit.switchDevice",
        "title": "Switch device",
        "category": "Decky",
        "icon": "$(vm)"
      },
      {
        "command": "decky-toolkit.connect",
        "title": "Connect",
        "category": "Decky",
        "icon": "$(plug)"
      },
      {
        "command": "decky-toolkit.disconnectDevice",
        "title": "Disconnect",
        "category": "Decky",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "decky-toolkit.pairAgain",
        "title": "Re-pair",
        "category": "Decky",
        "icon": "$(key)"
      },
      {
        "command": "decky-toolkit.copyViewerUrl",
        "title": "Copy viewer URL",
        "category": "Decky",
        "icon": "$(copy)"
      },
      {
        "command": "decky-toolkit.deviceActions",
        "title": "More actions…",
        "category": "Decky",
        "icon": "$(ellipsis)"
      }
    ],
    "configuration": {
      "title": "Decky Toolkit",
      "properties": {
        "decky-toolkit.host": {
          "type": "string",
          "default": "",
          "description": "IP address or hostname of the device running the Decky Toolkit plugin."
        },
        "decky-toolkit.port": {
          "type": "number",
          "default": 8765,
          "description": "Port of the Decky Toolkit HTTP server."
        },
        "decky-toolkit.pluginDirName": {
          "type": "string",
          "default": "",
          "description": "Directory name under ~/homebrew/plugins to deploy to. Empty means the workspace folder's name."
        },
        "decky-toolkit.openScreenOnConnect": {
          "type": "boolean",
          "default": true,
          "description": "Open the live screen panel after the first successful connect of a session."
        },
        "decky-toolkit.deploy.build": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Run the package.json build script only when src/ (or tsconfig/rollup config) is newer than dist/index.js",
            "Always run the build script before deploying",
            "Never build; deploy dist/ as it is"
          ],
          "default": "auto",
          "description": "Whether Deploy runs `pnpm run build` (or npm/yarn, from the lockfile) first. Python files never need a build."
        },
        "decky-toolkit.deploy.onChange": {
          "type": "boolean",
          "default": false,
          "description": "Deploy the workspace plugin (fast, without building) whenever dist/index.js, main.py or py_modules/**/*.py change. Keep your build running in watch mode (`pnpm run watch`)."
        }
      }
    },
    "keybindings": [
      {
        "command": "decky-toolkit.deploy",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "decky-toolkit.addDevice",
          "when": "view == decky-toolkit.devices",
          "group": "navigation@1"
        },
        {
          "command": "decky-toolkit.refresh",
          "when": "view == decky-toolkit.devices",
          "group": "navigation@2"
        },
        {
          "command": "decky-toolkit.openScreen",
          "when": "view == decky-toolkit.actions",
          "group": "navigation@1"
        },
        {
          "command": "decky-toolkit.refresh",
          "when": "view == decky-toolkit.actions",
          "group": "navigation@2"
        },
        {
          "command": "decky-toolkit.installZip",
          "when": "view == decky-toolkit.plugins",
          "group": "navigation@1"
        },
        {
          "command": "decky-toolkit.refreshPlugins",
          "when": "view == decky-toolkit.plugins",
          "group": "navigation@2"
        },
        {
          "command": "decky-toolkit.addVirtualController",
          "when": "view == decky-toolkit.controllers",
          "group": "navigation@1"
        },
        {
          "command": "decky-toolkit.refreshControllers",
          "when": "view == decky-toolkit.controllers",
          "group": "navigation@2"
        },
        {
          "command": "decky-toolkit.openScreen",
          "when": "view == decky-toolkit.preview",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "decky-toolkit.reloadPlugin",
          "when": "view == decky-toolkit.plugins && viewItem == plugin",
          "group": "inline@1"
        },
        {
          "command": "decky-toolkit.pluginLogs",
          "when": "view == decky-toolkit.plugins && viewItem == plugin",
          "group": "inline@2"
        },
        {
          "command": "decky-toolkit.reloadPlugin",
          "when": "view == decky-toolkit.plugins && viewItem == plugin",
          "group": "1_plugin@1"
        },
        {
          "command": "decky-toolkit.pluginLogs",
          "when": "view == decky-toolkit.plugins && viewItem == plugin",
          "group": "1_plugin@2"
        },
        {
          "command": "decky-toolkit.openPluginPanel",
          "when": "view == decky-toolkit.plugins && viewItem == plugin",
          "group": "1_plugin@3"
        },
        {
          "command": "decky-toolkit.removeVirtualController",
          "when": "view == decky-toolkit.controllers && viewItem == controller.virtual",
          "group": "inline@1"
        },
        {
          "command": "decky-toolkit.removeVirtualController",
          "when": "view == decky-toolkit.controllers && viewItem == controller.virtual",
          "group": "1_controller@1"
        },
        {
          "command": "decky-toolkit.connect",
          "when": "view == decky-toolkit.devices && viewItem =~ /^deck\\.(unpaired|paired)$/",
          "group": "inline@1"
        },
        {
          "command": "decky-toolkit.disconnectDevice",
          "when": "view == decky-toolkit.devices && viewItem == deck.session",
          "group": "inline@1"
        },
        {
          "command": "decky-toolkit.deviceActions",
          "when": "view == decky-toolkit.devices && viewItem =~ /^deck\\.(unpaired|paired|session)$/",
          "group": "inline@2"
        },
        {
          "command": "decky-toolkit.connect",
          "when": "view == decky-toolkit.devices && viewItem =~ /^deck\\.(unpaired|paired)$/",
          "group": "1_connect@1"
        },
        {
          "command": "decky-toolkit.disconnectDevice",
          "when": "view == decky-toolkit.devices && viewItem == deck.session",
          "group": "1_connect@1"
        },
        {
          "command": "decky-toolkit.pairAgain",
          "when": "view == decky-toolkit.devices && viewItem =~ /^deck\\.(paired|session)$/",
          "group": "2_pair@1"
        },
        {
          "command": "decky-toolkit.enterToken",
          "when": "view == decky-toolkit.devices && viewItem =~ /^deck\\.(unpaired|paired|session)$/",
          "group": "2_pair@2"
        },
        {
          "command": "decky-toolkit.editDevice",
          "when": "view == decky-toolkit.devices && viewItem =~ /^deck\\.(unpaired|paired|session)$/",
          "group": "3_device@1"
        },
        {
          "command": "decky-toolkit.copyViewerUrl",
          "when": "view == decky-toolkit.devices && viewItem =~ /^deck\\./",
          "group": "3_device@2"
        },
        {
          "command": "decky-toolkit.removeDevice",
          "when": "view == decky-toolkit.devices && viewItem =~ /^deck\\.(unpaired|paired|session)$/",
          "group": "3_device@3"
        }
      ],
      "commandPalette": [
        {
          "command": "decky-toolkit.deviceActions",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/jackhric/decky-toolkit/blob/HEAD/extension --baseImagesUrl https://github.com/jackhric/decky-toolkit/raw/HEAD/extension",
    "smoke": "node scripts/smoke.mjs",
    "dev-check": "node scripts/dev-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
