          "command": "decky-toolkit.gameLaunch",
          "when": "view == decky-toolkit.games && viewItem == game",
          "group": "1_game@2"
        },
        {
          "command": "decky-toolkit.gameTerminate",
          "when": "view == decky-toolkit.games && viewItem == game.running",
          "group": "1_game@2"
        },
        {
          "command": "decky-toolkit.gameProtonLog",
          "when": "view == decky-toolkit.games && viewItem =~ /^game(\\.running)?$/",
          "group": "1_game@3"
        },
        {
          "command": "decky-toolkit.copyDeckyPath",
          "when": "view == decky-toolkit.games && viewItem =~ /^game(\\.running)?$/",
          "group": "2_path@1"
        },
        {
          "command": "decky-toolkit.openInExplorer",
          "when": "view == decky-toolkit.games && viewItem == deckyDir",
          "group": "inline@1"
        },
        {
          "command": "decky-toolkit.openInExplorer",
          "when": "view == decky-toolkit.games && viewItem =~ /^decky(Dir|File)$/",
          "group": "1_path@1"
        },
        {
          "command": "decky-toolkit.copyDeckyPath",
          "when": "view == decky-toolkit.games && viewItem =~ /^decky(Dir|File)$/",
          "group": "1_path@2"
        },
        {
          "command": "decky-toolkit.connectFound",
          "when": "view == decky-toolkit.devices && viewItem == deck.found",
          "group": "inline@1"
        },
        {
          "command": "decky-toolkit.connectFound",
          "when": "view == decky-toolkit.devices && viewItem == deck.found",
          "group": "1_connect@1"
        },
        {
          "command": "decky-toolkit.searchNetwork",
          "when": "view == decky-toolkit.devices && viewItem == discovery.group",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "decky-toolkit.deviceActions",
          "when": "false"
        },
        {
          "command": "decky-toolkit.openInExplorer",
          "when": "false"
        },
        {
          "command": "decky-toolkit.copyDeckyPath",
          "when": "false"
        },
        {
          "command": "decky-toolkit.screen.inputOn",
          "when": "false"
        },
        {
          "command": "decky-toolkit.screen.inputOff",
          "when": "false"
        },
        {
          "command": "decky-toolkit.screen.mute",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen'"
        },
        {
          "command": "decky-toolkit.screen.unmute",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen'"
        },
        {
          "command": "decky-toolkit.screen.settings",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen'"
        },
        {
          "command": "decky-toolkit.screen.pause",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen'"
        },
        {
          "command": "decky-toolkit.screen.resume",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen'"
        },
        {
          "command": "decky-toolkit.connectFound",
          "when": "false"
        },
        {
          "command": "decky-toolkit.searchNetwork",
          "when": "config.decky-toolkit.discovery.enabled"
        }
      ],
      "editor/title": [
        {
          "command": "decky-toolkit.reconnect",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen' && !decky-toolkit.screen.live",
          "group": "navigation@0"
        },
        {
          "command": "decky-toolkit.screen.inputOn",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen' && decky-toolkit.screen.input != 'on' && decky-toolkit.screen.live",
          "group": "navigation@1"
        },
        {
          "command": "decky-toolkit.screen.inputOff",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen' && decky-toolkit.screen.input == 'on' && decky-toolkit.screen.live",
          "group": "navigation@1"
        },
        {
          "command": "decky-toolkit.screen.mute",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen' && decky-toolkit.screen.audio && !decky-toolkit.screen.muted",
          "group": "navigation@2"
        },
        {
          "command": "decky-toolkit.screen.unmute",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen' && decky-toolkit.screen.audio && decky-toolkit.screen.muted",
          "group": "navigation@2"
        },
        {
          "command": "decky-toolkit.screen.settings",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen' && decky-toolkit.screen.live",
          "group": "navigation@3"
        },
        {
          "command": "decky-toolkit.screen.pause",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen' && !decky-toolkit.screen.paused",
          "group": "navigation@4"
        },
        {
          "command": "decky-toolkit.screen.resume",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen' && decky-toolkit.screen.paused",
          "group": "navigation@4"
        },
        {
          "command": "decky-toolkit.snapshot",
          "when": "activeWebviewPanelId == 'decky-toolkit.screen' && decky-toolkit.screen.live",
          "group": "navigation@5"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "pairing",
        "title": "Connect a Decky device",
        "description": "Install the plugin on your device, add it here and approve it on the device.",
        "steps": [
          {
            "id": "install",
            "title": "Install the Decky Toolkit plugin",
            "description": "The device needs [Decky Loader](https://github.com/SteamDeckHomebrew/decky-loader) and the Decky Toolkit plugin. In Decky's settings turn on **Developer mode**, then open **Developer → Install Plugin from URL** and enter **jackhric.github.io/decky-toolkit/decky-toolkit.zip**.\n[Open the plugin on GitHub](https://github.com/jackhric/decky-toolkit)",
            "media": {
              "svg": "media/mark-flat.svg",
              "altText": "The Decky Toolkit logo: a mug with a Steam Deck mark and a terminal badge"
            }
          },
          {
            "id": "add",
            "title": "Add your device",
            "description": "Enter the device's IP address. It is shown in large type in Quick Access → **Decky Toolkit** on the device.\n[Add a device](command:decky-toolkit.addDevice)",
            "media": {
              "svg": "media/mark-flat.svg",
              "altText": "The Decky Toolkit logo: a mug with a Steam Deck mark and a terminal badge"
            },
            "completionEvents": [
              "onCommand:decky-toolkit.addDevice"
            ]
          },
          {
            "id": "approve",
            "title": "Approve it on the device",
            "description": "Click the device in the **Devices** view. VS Code shows a four-digit code, and the device shows a toast with the same code. In Quick Access → **Decky Toolkit**, check the code and press **Approve**.",
            "media": {
              "svg": "media/mark-flat.svg",
              "altText": "The Decky Toolkit logo: a mug with a Steam Deck mark and a terminal badge"
            },
            "completionEvents": [
              "onContext:decky-toolkit.connected"
            ]
          },
          {
            "id": "screen",
            "title": "Open the screen",
            "description": "Once connected, the device's screen opens beside your editor, with sound.\n[Open screen](command:decky-toolkit.openScreen)",
            "media": {
              "svg": "media/mark-flat.svg",
              "altText": "The Decky Toolkit logo: a mug with a Steam Deck mark and a terminal badge"
            },
            "completionEvents": [
              "onCommand:decky-toolkit.openScreen"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies --baseContentUrl https://github.com/jackhric/decky-toolkit/blob/HEAD/extension --baseImagesUrl https://github.com/jackhric/decky-toolkit/raw/HEAD/extension",
    "smoke": "node scripts/smoke.mjs",
    "dev-check": "node scripts/dev-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
