{
  "name": "decky-mcp",
  "displayName": "Decky-MCP",
  "description": "Live screen, deploy, logs and Steam console for Decky plugin development against a Decky-MCP device",
  "version": "0.3.0",
  "publisher": "jackhric",
  "icon": "media/icon.png",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jackh/decky-mcp.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "decky",
    "steam deck",
    "mcp"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:plugin.json",
    "onView:decky-mcp.devices",
    "onView:decky-mcp.device",
    "onView:decky-mcp.plugins",
    "onView:decky-mcp.preview",
    "onView:decky-mcp.unified"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "decky-mcp",
          "title": "Decky",
          "icon": "media/decky.svg"
        }
      ]
    },
    "views": {
      "decky-mcp": [
        {
          "id": "decky-mcp.devices",
          "name": "Devices",
          "icon": "media/decky.svg",
          "when": "(decky-mcp.layout == devices-first || !decky-mcp.layout)"
        },
        {
          "id": "decky-mcp.unified",
          "name": "Decky",
          "icon": "media/decky.svg",
          "when": "decky-mcp.layout == unified"
        },
        {
          "id": "decky-mcp.device",
          "name": "Device",
          "icon": "media/decky.svg",
          "when": "decky-mcp.layout == classic || (decky-mcp.layout == devices-first || !decky-mcp.layout) && decky-mcp.connected"
        },
        {
          "id": "decky-mcp.plugins",
          "name": "Plugins",
          "icon": "media/decky.svg",
          "when": "decky-mcp.layout == classic || (decky-mcp.layout == devices-first || !decky-mcp.layout) && decky-mcp.connected"
        },
        {
          "type": "webview",
          "id": "decky-mcp.preview",
          "name": "Preview",
          "icon": "media/decky.svg",
          "when": "decky-mcp.layout == classic || decky-mcp.connected"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "decky-mcp.devices",
        "contents": "No devices yet.\n[Add a Deck](command:decky-mcp.addDevice)"
      },
      {
        "view": "decky-mcp.unified",
        "contents": "No devices yet.\n[Add a Deck](command:decky-mcp.addDevice)"
      },
      {
        "view": "decky-mcp.device",
        "when": "decky-mcp.layout == classic && !decky-mcp.paired",
        "contents": "Not paired with the active Deck yet.\nClick Pair, then on the Deck open the Quick Access menu (…), choose Decky-MCP and press \"Pair a browser\" within two minutes.\n[Pair with device](command:decky-mcp.pair)\nOlder device plugin without pairing? Paste the token shown in the Decky-MCP panel instead.\n[Enter token manually](command:decky-mcp.enterToken)\nWrong Deck? [Switch device](command:decky-mcp.switchDevice) · [Add device](command:decky-mcp.addDevice) · [Change host](command:decky-mcp.changeHost)"
      },
      {
        "view": "decky-mcp.plugins",
        "when": "decky-mcp.layout == classic && !decky-mcp.paired",
        "contents": "Pair with the Deck to list, reload and install its Decky plugins.\n[Pair with device](command:decky-mcp.pair)"
      }
    ],
    "commands": [
      {
        "command": "decky-mcp.pair",
        "title": "Pair with device",
        "category": "Decky",
        "icon": "$(plug)"
      },
      {
        "command": "decky-mcp.enterToken",
        "title": "Enter token manually",
        "category": "Decky",
        "icon": "$(key)"
      },
      {
        "command": "decky-mcp.disconnect",
        "title": "Disconnect and forget token",
        "category": "Decky",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "decky-mcp.openScreen",
        "title": "Open screen",
        "category": "Decky",
        "icon": "$(device-desktop)"
      },
      {
        "command": "decky-mcp.deploy",
        "title": "Deploy plugin",
        "category": "Decky",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "decky-mcp.restartLoader",
        "title": "Restart loader",
        "category": "Decky",
        "icon": "$(debug-restart)"
      },
      {
        "command": "decky-mcp.reloadPlugin",
        "title": "Reload plugin",
        "category": "Decky",
        "icon": "$(refresh)"
      },
      {
        "command": "decky-mcp.loaderLogs",
        "title": "Show loader logs",
        "category": "Decky",
        "icon": "$(output)"
      },
      {
        "command": "decky-mcp.pluginLogs",
        "title": "Show plugin logs",
        "category": "Decky",
        "icon": "$(output)"
      },
      {
        "command": "decky-mcp.evaluate",
        "title": "Evaluate JS in Steam UI",
        "category": "Decky"
      },
      {
        "command": "decky-mcp.toast",
        "title": "Toast on Deck",
        "category": "Decky"
      },
      {
        "command": "decky-mcp.writeMcpConfig",
        "title": "Write MCP config for this workspace",
        "category": "Decky"
      },
      {
        "command": "decky-mcp.refresh",
        "title": "Refresh",
        "category": "Decky",
        "icon": "$(refresh)"
      },
      {
        "command": "decky-mcp.refreshPlugins",
        "title": "Refresh plugins",
        "category": "Decky",
        "icon": "$(refresh)"
      },
      {
        "command": "decky-mcp.installZip",
        "title": "Install plugin zip…",
        "category": "Decky",
        "icon": "$(package)"
      },
      {
        "command": "decky-mcp.changeHost",
        "title": "Change host",
        "category": "Decky",
        "icon": "$(server)"
      },
      {
        "command": "decky-mcp.addDevice",
        "title": "Add device…",
        "category": "Decky",
        "icon": "$(add)"
      },
      {
        "command": "decky-mcp.editDevice",
        "title": "Edit device",
        "category": "Decky",
        "icon": "$(edit)"
      },
      {
        "command": "decky-mcp.removeDevice",
        "title": "Remove device",
        "category": "Decky",
        "icon": "$(trash)"
      },
      {
        "command": "decky-mcp.setActiveDevice",
        "title": "Set active device",
        "category": "Decky",
        "icon": "$(check)"
      },
      {
        "command": "decky-mcp.switchDevice",
        "title": "Switch device",
        "category": "Decky",
        "icon": "$(vm)"
      },
      {
        "command": "decky-mcp.connect",
        "title": "Connect",
        "category": "Decky",
        "icon": "$(plug)"
      },
      {
        "command": "decky-mcp.disconnectDevice",
        "title": "Disconnect",
        "category": "Decky",
        "icon": "$(debug-disconnect)"
      },
      {
        "command": "decky-mcp.pairAgain",
        "title": "Re-pair",
        "category": "Decky",
        "icon": "$(key)"
      },
      {
        "command": "decky-mcp.copyViewerUrl",
        "title": "Copy viewer URL",
        "category": "Decky",
        "icon": "$(copy)"
      },
      {
        "command": "decky-mcp.deviceActions",
        "title": "More actions…",
        "category": "Decky",
        "icon": "$(ellipsis)"
      },
      {
        "command": "decky-mcp.switchLayout",
        "title": "Switch sidebar layout",
        "category": "Decky",
        "icon": "$(gear)"
      }
    ],
    "configuration": {
      "title": "Decky-MCP",
      "properties": {
        "decky-mcp.host": {
          "type": "string",
          "default": "10.0.70.18",
          "description": "IP address or hostname of the Steam Deck running the Decky-MCP plugin."
        },
        "decky-mcp.port": {
          "type": "number",
          "default": 8765,
          "description": "Port of the Decky-MCP HTTP server."
        },
        "decky-mcp.pluginDirName": {
          "type": "string",
          "default": "",
          "description": "Directory name under ~/homebrew/plugins to deploy to. Empty means the workspace folder's name."
        },
        "decky-mcp.sidebarLayout": {
          "type": "string",
          "enum": [
            "devices-first",
            "unified",
            "classic"
          ],
          "enumDescriptions": [
            "A list of saved Decks; the Device, Plugins and Preview views appear once you connect to one.",
            "One tree: every Deck is a row, the connected one expands to Screen, Plugins, Actions and Settings.",
            "The 0.2 sidebar: active device, connection, Screen and Actions in the Device view."
          ],
          "default": "devices-first",
          "description": "Layout of the Decky sidebar. Switch live with \"Decky: Switch sidebar layout\" (gear icon in each Decky view)."
        },
        "decky-mcp.openScreenOnConnect": {
          "type": "boolean",
          "default": true,
          "description": "Open the live screen panel after the first successful connect of a session."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "decky-mcp.pair",
          "when": "view == decky-mcp.device && decky-mcp.layout == classic",
          "group": "navigation@1"
        },
        {
          "command": "decky-mcp.openScreen",
          "when": "view == decky-mcp.device && (decky-mcp.layout == classic && decky-mcp.paired || decky-mcp.layout != classic)",
          "group": "navigation@2"
        },
        {
          "command": "decky-mcp.refresh",
          "when": "view == decky-mcp.device && decky-mcp.layout == classic",
          "group": "navigation@3"
        },
        {
          "command": "decky-mcp.switchDevice",
          "when": "view == decky-mcp.device && decky-mcp.layout == classic",
          "group": "devices@1"
        },
        {
          "command": "decky-mcp.addDevice",
          "when": "view == decky-mcp.device && decky-mcp.layout == classic",
          "group": "devices@2"
        },
        {
          "command": "decky-mcp.installZip",
          "when": "view == decky-mcp.plugins && decky-mcp.paired",
          "group": "navigation@1"
        },
        {
          "command": "decky-mcp.refreshPlugins",
          "when": "view == decky-mcp.plugins",
          "group": "navigation@2"
        },
        {
          "command": "decky-mcp.openScreen",
          "when": "view == decky-mcp.preview && decky-mcp.paired",
          "group": "navigation@1"
        },
        {
          "command": "decky-mcp.addDevice",
          "when": "view == decky-mcp.devices || view == decky-mcp.unified",
          "group": "navigation@1"
        },
        {
          "command": "decky-mcp.refresh",
          "when": "view == decky-mcp.devices || view == decky-mcp.unified",
          "group": "navigation@2"
        },
        {
          "command": "decky-mcp.disconnectDevice",
          "when": "view == decky-mcp.device && decky-mcp.layout != classic",
          "group": "navigation@3"
        },
        {
          "command": "decky-mcp.switchLayout",
          "when": "view =~ /^decky-mcp\\./",
          "group": "navigation@9"
        }
      ],
      "view/item/context": [
        {
          "command": "decky-mcp.addDevice",
          "when": "view == decky-mcp.device && viewItem == devices",
          "group": "inline"
        },
        {
          "command": "decky-mcp.editDevice",
          "when": "view == decky-mcp.device && viewItem =~ /^device(\\.active)?$/",
          "group": "inline@1"
        },
        {
          "command": "decky-mcp.removeDevice",
          "when": "view == decky-mcp.device && viewItem =~ /^device(\\.active)?$/",
          "group": "inline@2"
        },
        {
          "command": "decky-mcp.setActiveDevice",
          "when": "view == decky-mcp.device && viewItem == device",
          "group": "1_device@1"
        },
        {
          "command": "decky-mcp.editDevice",
          "when": "view == decky-mcp.device && viewItem =~ /^device(\\.active)?$/",
          "group": "1_device@2"
        },
        {
          "command": "decky-mcp.removeDevice",
          "when": "view == decky-mcp.device && viewItem =~ /^device(\\.active)?$/",
          "group": "1_device@3"
        },
        {
          "command": "decky-mcp.refresh",
          "when": "view == decky-mcp.device && viewItem == connection",
          "group": "inline@1"
        },
        {
          "command": "decky-mcp.changeHost",
          "when": "view == decky-mcp.device && viewItem == connection",
          "group": "inline@2"
        },
        {
          "command": "decky-mcp.openScreen",
          "when": "view =~ /^decky-mcp\\.(device|unified)$/ && viewItem == screen",
          "group": "inline"
        },
        {
          "command": "decky-mcp.reloadPlugin",
          "when": "view =~ /^decky-mcp\\.(plugins|unified)$/ && viewItem == plugin",
          "group": "inline@1"
        },
        {
          "command": "decky-mcp.pluginLogs",
          "when": "view =~ /^decky-mcp\\.(plugins|unified)$/ && viewItem == plugin",
          "group": "inline@2"
        },
        {
          "command": "decky-mcp.reloadPlugin",
          "when": "view =~ /^decky-mcp\\.(plugins|unified)$/ && viewItem == plugin",
          "group": "1_plugin@1"
        },
        {
          "command": "decky-mcp.pluginLogs",
          "when": "view =~ /^decky-mcp\\.(plugins|unified)$/ && viewItem == plugin",
          "group": "1_plugin@2"
        },
        {
          "command": "decky-mcp.connect",
          "when": "view =~ /^decky-mcp\\.(devices|unified)$/ && viewItem =~ /^deck\\.(unpaired|paired)$/",
          "group": "inline@1"
        },
        {
          "command": "decky-mcp.disconnectDevice",
          "when": "view =~ /^decky-mcp\\.(devices|unified)$/ && viewItem == deck.session",
          "group": "inline@1"
        },
        {
          "command": "decky-mcp.deviceActions",
          "when": "view =~ /^decky-mcp\\.(devices|unified)$/ && viewItem =~ /^deck\\.(unpaired|paired|session)$/",
          "group": "inline@2"
        },
        {
          "command": "decky-mcp.connect",
          "when": "view =~ /^decky-mcp\\.(devices|unified)$/ && viewItem =~ /^deck\\.(unpaired|paired)$/",
          "group": "1_connect@1"
        },
        {
          "command": "decky-mcp.disconnectDevice",
          "when": "view =~ /^decky-mcp\\.(devices|unified)$/ && viewItem == deck.session",
          "group": "1_connect@1"
        },
        {
          "command": "decky-mcp.pairAgain",
          "when": "view =~ /^decky-mcp\\.(devices|unified)$/ && viewItem =~ /^deck\\.(paired|session)$/",
          "group": "2_pair@1"
        },
        {
          "command": "decky-mcp.enterToken",
          "when": "view =~ /^decky-mcp\\.(devices|unified)$/ && viewItem =~ /^deck\\.(unpaired|paired|session)$/",
          "group": "2_pair@2"
        },
        {
          "command": "decky-mcp.editDevice",
          "when": "view =~ /^decky-mcp\\.(devices|unified)$/ && viewItem =~ /^deck\\.(unpaired|paired|session)$/",
          "group": "3_device@1"
        },
        {
          "command": "decky-mcp.copyViewerUrl",
          "when": "view =~ /^decky-mcp\\.(devices|unified)$/ && viewItem =~ /^deck\\./",
          "group": "3_device@2"
        },
        {
          "command": "decky-mcp.removeDevice",
          "when": "view =~ /^decky-mcp\\.(devices|unified)$/ && viewItem =~ /^deck\\.(unpaired|paired|session)$/",
          "group": "3_device@3"
        }
      ],
      "commandPalette": [
        {
          "command": "decky-mcp.setActiveDevice",
          "when": "false"
        },
        {
          "command": "decky-mcp.deviceActions",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "package": "vsce package --no-dependencies",
    "smoke": "node scripts/smoke.mjs",
    "dev-check": "node scripts/dev-check.mjs"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
