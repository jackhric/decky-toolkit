{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node", "vscode"],
    "paths": { "@decky-toolkit/client/*": ["../packages/client/src/*"] }
  },
  "include": ["src", "../packages/client/src"]
}
