---
import { icons, type IconName } from './icons';

interface Props { name: IconName; size?: number; label?: string; class?: string }
const { name, size = 20, label, class: className } = Astro.props;
const icon = icons[name];
---

<svg viewBox={icon.viewBox} width={size} height={size} fill="currentColor" fill-rule="evenodd" class={className}
  style={`color: var(--icon-${name}, currentColor)`}
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
  <path d={icon.d} />
</svg>
