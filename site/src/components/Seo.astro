---
import extension from '../../../extension/package.json';
import { editors } from '../data/editors';

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const repo = 'https://github.com/jackhric/decky-toolkit';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(`${import.meta.env.BASE_URL.replace(/\/$/, '')}/og.jpg`, Astro.site).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: 'Decky Toolkit', url: canonical },
    {
      '@type': 'SoftwareSourceCode',
      name: 'Decky Toolkit',
      codeRepository: repo,
      programmingLanguage: ['TypeScript', 'Python'],
      license: `${repo}/blob/main/LICENSE`,
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Decky Toolkit',
      description,
      url: canonical,
      image,
      applicationCategory: 'DeveloperApplication',
      applicationSubCategory: 'Decky Loader plugin development',
      operatingSystem: 'SteamOS, Bazzite, Linux (device); Windows, macOS, Linux (VS Code or VSCodium)',
      softwareVersion: extension.version,
      license: `${repo}/blob/main/LICENSE`,
      isAccessibleForFree: true,
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      downloadUrl: editors.vscode.store,
      installUrl: editors.vscode.store,
      sameAs: [repo, editors.vscode.store, editors.vscodium.store],
      author: { '@type': 'Person', name: 'Jack Hric', url: 'https://jackhric.com' },
      keywords: 'Decky Loader plugin, Decky plugin development, Steam Deck plugin, Steam Deck homebrew, SteamOS, Bazzite, decky-plugin-template, hot reload, CEF debugging, SharedJSContext, VS Code extension, VSCodium, MCP server',
      featureList: [
        'Hot reload of a Decky Loader plugin without restarting Decky Loader',
        'Live screen and audio of the Steam Deck in an editor tab',
        'Remote keyboard, mouse and gamepad input, virtual Xbox 360 controllers',
        'Decky Loader and plugin logs streamed into output channels',
        "JavaScript console for Steam's SharedJSContext",
        'HTTP API and MCP server for scripts and coding agents',
      ],
    },
  ],
};
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/sitemap-index.xml`} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Decky Toolkit" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Decky Toolkit: build, test and deploy Decky Loader plugins from VS Code or VSCodium" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
