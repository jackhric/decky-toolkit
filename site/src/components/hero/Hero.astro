---
import SteamLogo from './SteamLogo.astro';
import EditorBadge from '../EditorBadge.astro';
import EditorButton from '../EditorButton.astro';
import { Button } from '@/components/starwind/button';
import Icon from '../Icon.astro';
import Tile from './Tile.astro';
import { heroTiles } from './tiles';

interface Props { marketplace: string; openVsx: string; repo: string }
const { marketplace, openVsx, repo } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const navIcons = [
  { name: 'vscode', href: marketplace, label: 'VS Code Marketplace' },
  { name: 'vscodium', href: openVsx, label: 'Open VSX' },
  { name: 'github', href: repo, label: 'GitHub' },
] as const;
const iconButton = 'text-(--hero-text) rounded-lg hover:bg-(--hero-text)/8 hover:text-(--hero-text) select-none';
const docsButton = `docs text-base px-2.5 -ml-2.5 ${iconButton}`;
const tiles = heroTiles(72);
const COLS = 6;
// Deterministic per-cell noise, so server renders match and the scroll loop's two halves line up.
const noise = (i: number, salt: number) => {
  let h = Math.imul(i + 1, 0x9e3779b1) ^ Math.imul(salt + 7, 0x85ebca6b);
  h = Math.imul(h ^ (h >>> 15), 0x2c1b3c6d);
  return ((h ^ (h >>> 13)) >>> 0) / 4294967296;
};
const cell = (i: number) => {
  const k = i % tiles.length, col = k % COLS, row = Math.floor(k / COLS);
  // One shared period keeps the swell coherent; phase runs diagonally across the grid, with a little jitter per card.
  const phase = col * 0.85 + row * 0.65 + (noise(k, 1) - 0.5) * 0.5;
  return [
    `--in:${(0.25 + noise(k, 2) * 1.5).toFixed(2)}s`,
    `--wd:${(-phase).toFixed(2)}s`,
    `--wa:${(5 + noise(k, 3) * 4).toFixed(1)}px`,
  ].join(';');
};
---

<section class="hero">
  <div class="stage" aria-hidden="true">
    <div class="glow"></div>
    <div class="plane">
      <div class="scroll">
        {[...tiles, ...tiles].map((t, i) => <Tile tile={t} cell={cell(i)} />)}
      </div>
    </div>
  </div>
  <div class="shade"></div>

  <header class="top">
    <nav>
      <a href="#features">Features</a>
      <a href="#get-started">Get started</a>
      <a href={`${base}/docs/faq/`}>FAQ</a>
      <Button href={`${base}/docs/`} variant="ghost" size="sm" class={docsButton}>
        Docs
      </Button>
      <span class="icons">
        {navIcons.map(({ name, href, label }) => (
          <Button href={href} title={label} variant="ghost" size="icon-sm" class={iconButton}>
            <Icon name={name} label={label} class="size-5" />
          </Button>
        ))}
      </span>
    </nav>
  </header>

  <div class="content">
    <SteamLogo class="logo" />
    <h1>
      <span class="line">Build, test and deploy</span>{' '}
      <span class="line">Decky&nbsp;Loader plugins</span>{' '}
      <span class="line">from <span class="editors"><EditorBadge editor="vscode" size="lg" /> or <EditorBadge editor="vscodium" size="lg" /></span></span>
    </h1>
    <div class="ctas">
      <EditorButton editor="vscode" primary />
      <EditorButton editor="vscodium" />
    </div>
  </div>
</section>

<script>
  const videos = [...document.querySelectorAll<HTMLVideoElement>('.hero video[data-webm]')];
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const golden = 0.618034;

  // A clip card stays hidden (its fade-in paused) until its poster has decoded, so no card shows up blank.
  // Posters load a few at a time, which staggers their arrival; each card's own --in delay staggers the fade.
  // Both copies of a card (the loop renders the tiles twice) share a poster and are revealed together, so the loop's
  // wrap never swaps a visible card for a hidden twin.
  const byPoster = new Map<string, HTMLElement[]>();
  for (const el of document.querySelectorAll<HTMLElement>('.hero .tile:not(.ready)')) {
    const poster = el.querySelector('video')?.poster ?? '';
    byPoster.set(poster, [...(byPoster.get(poster) ?? []), el]);
  }
  const pending = [...byPoster];
  const ready = (els: HTMLElement[]) => els.forEach(el => el.classList.add('ready'));
  let next = 0;
  function pump() {
    const item = pending[next++];
    if (!item) return;
    const [poster, els] = item;
    if (!poster) { ready(els); pump(); return; }
    const img = new Image();
    img.decoding = 'async';
    img.src = poster;
    img.decode().catch(() => {}).finally(() => { ready(els); pump(); });
  }
  for (let i = 0; i < 6; i++) pump();

  function load(video: HTMLVideoElement, i: number) {
    if (video.dataset.loaded) return;
    video.dataset.loaded = '1';
    for (const [type, key] of [['video/webm', 'webm'], ['video/mp4', 'mp4']] as const) {
      const source = document.createElement('source');
      source.type = type;
      source.src = video.dataset[key]!;
      video.append(source);
    }
    video.addEventListener('loadedmetadata', () => {
      video.currentTime = ((i * golden) % 1) * video.duration;
      video.playbackRate = 0.85 + ((i * golden * 7) % 1) * 0.3;
    }, { once: true });
    video.load();
  }

  // Decoding is the hero's main cost, so at most MAX_PLAYING clips run, and only in the lower part of the view (the top
  // sits under the fade). The rest show their poster. Nothing downloads until the page has loaded and gone idle.
  const MAX_PLAYING = 12;
  const visible = new Set<HTMLVideoElement>();
  const playing = new Set<HTMLVideoElement>();
  function schedule() {
    for (const v of playing) if (!visible.has(v) || document.hidden) { v.pause(); playing.delete(v); }
    if (document.hidden) return;
    for (const v of visible) {
      if (playing.size >= MAX_PLAYING) break;
      if (playing.has(v)) continue;
      load(v, videos.indexOf(v));
      v.play().catch(() => {});
      playing.add(v);
    }
  }
  const observer = new IntersectionObserver(entries => {
    for (const { target, isIntersecting } of entries) {
      if (isIntersecting) visible.add(target as HTMLVideoElement);
      else visible.delete(target as HTMLVideoElement);
    }
    schedule();
  }, { rootMargin: '-30% 0px 0px 0px' });

  const start = () => videos.forEach(v => observer.observe(v));
  const idle = () => ('requestIdleCallback' in window ? requestIdleCallback(start, { timeout: 2000 }) : setTimeout(start, 300));
  if (!still.matches) {
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  }
  document.addEventListener('visibilitychange', schedule);

  // Off screen the hero costs nothing: its CSS animations pause (.away) and so do the clips.
  const hero = document.querySelector<HTMLElement>('.hero')!;
  new IntersectionObserver(([e]) => {
    hero.classList.toggle('away', !e.isIntersecting);
    if (e.isIntersecting) schedule();
    else for (const v of playing) { v.pause(); playing.delete(v); }
  }).observe(hero);
</script>

<style>
  .hero {
    position: relative; overflow: hidden; isolation: isolate; color: var(--hero-text); background: var(--hero-bg);
    min-height: min(92vh, 880px); display: flex; flex-direction: column;
  }
  .stage { position: absolute; inset: 0; user-select: none; -webkit-user-select: none; pointer-events: none; perspective: 1500px; perspective-origin: 62% 18%; }
  .glow {
    position: absolute; left: 30%; top: -10%; width: 90%; height: 120%;
    background: radial-gradient(closest-side, var(--hero-glow), color-mix(in srgb, var(--hero-glow) 35%, transparent) 50%, transparent 72%);
  }
  .plane {
    position: absolute; left: 36%; bottom: -34%; width: 1572px; height: 1896px;
    transform-origin: 50% 100%; --plane: rotateX(56deg) rotateZ(-13deg); transform: var(--plane);
    animation: drop-in 1.9s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  @keyframes drop-in {
    0% { transform: translate3d(0, -240px, 480px) var(--plane) rotateX(-16deg); }
    80% { transform: translate3d(0, 12px, -18px) var(--plane) rotateX(1.2deg); }
    100% { transform: translate3d(0, 0, 0) var(--plane) rotateX(0deg); }
  }
  /* Each card fades in after a random delay, then bobs on a slow swell whose phase rolls diagonally across the grid.
     Flat 2D transforms only: a preserve-3d plane made Chrome depth-sort every card and multiplied layer area at 4K.
     tile-in fills backwards only, so finished fades stop holding a compositor animation. */
  .scroll :global(.tile) {
    animation:
      tile-in 1.1s cubic-bezier(0.2, 0.8, 0.2, 1) var(--in, 0s) backwards,
      swell 9s ease-in-out var(--wd, 0s) infinite;
  }
  .scroll :global(.tile:not(.ready)) { animation-play-state: paused, running; }
  .hero.away .scroll, .hero.away .scroll :global(.tile) { animation-play-state: paused; }
  @keyframes tile-in { from { opacity: 0; translate: 0 46px; } }
  @keyframes swell {
    0%, 100% { transform: translateY(calc(var(--wa, 7px) * -1)); }
    50% { transform: translateY(var(--wa, 7px)); }
  }
  .glow { animation: glow-in 2.4s ease-out backwards; }
  @keyframes glow-in { from { opacity: 0; transform: scale(0.85); } }
  .plane::after {
    content: ''; position: absolute; inset: -25% 0 0; z-index: 1; pointer-events: none;
    background: linear-gradient(to top, color-mix(in srgb, var(--hero-bg) 0%, transparent) 38%, color-mix(in srgb, var(--hero-bg) 72%, transparent) 68%, var(--hero-bg) 86%);
  }
  .scroll {
    position: relative; display: grid; grid-template-columns: repeat(6, 262px); grid-auto-rows: 158px;
    will-change: transform; backface-visibility: hidden;
    animation: rise 72s linear infinite;
  }
  @keyframes rise { to { transform: translateY(-50%); } }
  .shade {
    position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(90deg, var(--hero-bg) 8%, color-mix(in srgb, var(--hero-bg) 94%, transparent) 30%, color-mix(in srgb, var(--hero-bg) 55%, transparent) 50%, color-mix(in srgb, var(--hero-bg) 8%, transparent) 72%, color-mix(in srgb, var(--hero-bg) 0%, transparent) 100%),
      linear-gradient(to bottom, var(--hero-bg), color-mix(in srgb, var(--hero-bg) 55%, transparent) 14%, color-mix(in srgb, var(--hero-bg) 0%, transparent) 36%, color-mix(in srgb, var(--hero-bg) 0%, transparent) 72%, var(--hero-bg));
  }

  .top {
    position: relative; z-index: 3; width: 100%; max-width: 1160px; margin: 0 auto; padding: 18px 28px;
    display: flex; align-items: center; justify-content: flex-end; gap: 16px; flex-wrap: wrap;
  }
  .top nav { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .top nav a { color: var(--hero-muted); text-decoration: none; font-weight: 500; }
  .top nav a:hover { color: var(--hero-text); }
  .icons { display: flex; gap: 4px; }

  .content {
    position: relative; z-index: 2; width: 100%; max-width: 1160px; margin: auto; padding: 64px 28px 112px;
  }
  .content :global(.logo) { width: min(440px, 80%); margin: 0 0 30px; }
  h1 {
    margin: 0 0 32px; font-size: clamp(2rem, 4.6vw, 3.3rem); line-height: 1.12; letter-spacing: -0.025em;
    text-wrap: balance; text-shadow: 0 2px 24px rgb(0 0 0 / 0.45);
  }
  h1 .editors { white-space: nowrap; }
  @media (min-width: 761px) { h1 .line { display: block; } }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }

  @media (max-width: 1100px) {
    .plane { left: 42%; }
    .stage { perspective-origin: 70% 18%; }
  }
  @media (max-width: 760px) {
    .hero { min-height: 100svh; }
    .top nav > a:not(.docs) { display: none; }
    .content { margin: auto 0 0; padding: max(26vh, 150px) 20px 48px; }
    .stage { perspective: 900px; perspective-origin: 50% 8%; }
    .glow { left: -20%; width: 140%; }
    .plane { left: -18%; bottom: 44%; --plane: rotateX(58deg) rotateZ(-14deg) scale(0.6); }
    .plane::after { background: linear-gradient(to top, color-mix(in srgb, var(--hero-bg) 0%, transparent) 30%, color-mix(in srgb, var(--hero-bg) 75%, transparent) 62%, var(--hero-bg) 82%); }
    .shade {
      background: linear-gradient(to bottom, var(--hero-bg) 0%, color-mix(in srgb, var(--hero-bg) 35%, transparent) 16%, color-mix(in srgb, var(--hero-bg) 25%, transparent) 40%, color-mix(in srgb, var(--hero-bg) 90%, transparent) 58%, var(--hero-bg) 70%);
    }
  }
  @media (max-width: 360px) {
    h1 { font-size: 1.7rem; }
  }
  @media (max-width: 400px) {
    .top { padding: 14px 16px; }
    .top nav { gap: 8px; }
    .icons { gap: 0; }
    .content { padding-inline: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll { animation-play-state: paused; }
    .plane, .glow, .scroll :global(.tile) { animation: none; }
    .scroll :global(.tile:not(.ready)) { opacity: 0; }
  }
</style>
