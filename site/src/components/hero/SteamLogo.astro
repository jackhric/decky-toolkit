---
import logo from '../../../../assets/decky-toolkit-dark.svg?url';

interface Props { class?: string; label?: string }
const { class: className, label = 'Decky Toolkit' } = Astro.props;

const view = { x: 131, y: 129, w: 2297.3, h: 488 };
const box = { x: 80, y: -250, w: 460, h: 404 };
const pct = (v: number) => `${(v * 100).toFixed(3)}%`;
const canvasStyle = [
  `left:${pct((box.x - view.x) / view.w)}`,
  `top:${pct((box.y - view.y) / view.h)}`,
  `width:${pct(box.w / view.w)}`,
  `height:${pct(box.h / view.h)}`,
].join(';');
---

<div class:list={['steam-logo', className]} data-box={JSON.stringify(box)}>
  <img src={logo} alt={label} width="2297" height="488" />
  <canvas class="steam" aria-hidden="true" style={canvasStyle}></canvas>
</div>

<script>
  const P = {
    rimY: 150, x0: 178, x1: 434,
    rise0: 60, rise1: 115, riseHeight: 260,
    turb: 42, laminar: 190, eddy0: 110, eddy1: 52, eddySpeed: 0.85,
    wind: 14, strands: 22, wander: 2.5, strandRate: 0.35, maxAge: 4.2,
    fadeIn: 14, alpha: 1.5, still: 0.6, maxDpr: 2,
  };
  const STEPS = 40;

  const VERT = `attribute vec2 a;varying vec2 v;void main(){v=a*.5+.5;gl_Position=vec4(a,0.,1.);}`;

  // Each pixel traces the flow backwards to the rim and shades by the emission there, so the
  // picture is a set of streaklines (how dye/smoke visualises a flow) through a curl-noise field.
  const FRAG = `precision highp float;
varying vec2 v;
uniform vec4 uBox, uColor, uScroll;
uniform vec4 uPhase;
uniform vec2 uRim;
#define STEPS ${STEPS}
const float DT = ${(P.maxAge / STEPS).toFixed(4)};
vec2 perm(vec2 x){return mod((x*34.+1.)*x,289.);}
vec2 grad(vec2 i){
  i=mod(i,289.);
  float k=perm(perm(vec2(i.x))+i.y).x;
  vec2 g=vec2(fract(k/41.),fract(k/7.))*2.-1.;
  return g;
}
vec3 noised(vec2 p){
  vec2 i=floor(p),f=p-i;
  vec2 u=f*f*f*(f*(f*6.-15.)+10.),du=30.*f*f*(f*(f-2.)+1.);
  vec2 ga=grad(i),gb=grad(i+vec2(1,0)),gc=grad(i+vec2(0,1)),gd=grad(i+1.);
  float va=dot(ga,f),vb=dot(gb,f-vec2(1,0)),vc=dot(gc,f-vec2(0,1)),vd=dot(gd,f-1.);
  float k=va-vb-vc+vd;
  return vec3(va+u.x*(vb-va)+u.y*(vc-va)+u.x*u.y*k,
    ga+u.x*(gb-ga)+u.y*(gc-ga)+u.x*u.y*(ga-gb-gc+gd)+du*(u.yx*k+vec2(vb,vc)-va));
}
vec2 vel(vec2 p,float age){
  float h=p.y;
  vec3 a=noised(vec2(p.x/${P.eddy0.toFixed(1)},h/${P.eddy0.toFixed(1)}-uScroll.x+age*uScroll.z));
  vec3 b=noised(vec2(p.x/${P.eddy1.toFixed(1)}+uScroll.w,h/${P.eddy1.toFixed(1)}-uScroll.y+age*uScroll.z*${(P.eddy0 / P.eddy1).toFixed(3)}));
  vec2 g=a.yz+.35*b.yz;
  float t=${P.turb.toFixed(1)}*mix(.05,1.,smoothstep(0.,${P.laminar.toFixed(1)},h));
  float rise=mix(${P.rise0.toFixed(1)},${P.rise1.toFixed(1)},smoothstep(0.,${P.riseHeight.toFixed(1)},h));
  float w=${P.wind.toFixed(1)}*(sin(uPhase.x-age*.29)+.6*sin(uPhase.y-age*.71))*smoothstep(10.,160.,h);
  return vec2(g.y*t+w,-g.x*t+rise);
}
void main(){
  vec2 p=vec2(uBox.x+v.x*uBox.z,uRim.x-(uBox.y+(1.-v.y)*uBox.w));
  float h0=p.y,age=0.,x0=0.,hit=0.;
  if(h0<0.){gl_FragColor=vec4(0);return;}
  for(int i=0;i<STEPS;i++){
    vec2 q=p-vel(p,age)*DT;
    if(q.y<=0.){float f=p.y/(p.y-q.y);x0=mix(p.x,q.x,f);age+=f*DT;hit=1.;break;}
    p=q;age+=DT;
  }
  float r=x0-uRim.y;
  float span=smoothstep(0.,40.,r)*smoothstep(${(P.x1 - P.x0).toFixed(1)},${(P.x1 - P.x0 - 40).toFixed(1)},r);
  float e=uPhase.z-age*${P.strandRate.toFixed(3)};
  float slow=uPhase.w-age*.15;
  float xs=x0/${P.strands.toFixed(1)}+${P.wander.toFixed(1)}*noised(vec2(x0/130.+7.,slow)).x;
  float n=noised(vec2(xs,e)).x+.5*noised(vec2(xs*.37+9.1,e+3.3)).x;
  float soft=.12+.5*age/${P.maxAge.toFixed(1)};
  float s=(.1+smoothstep(.1-soft*.5,.36+soft,n))*(.35+.65*smoothstep(-.4,.3,noised(vec2(x0/90.+4.,slow)).x));
  float life=exp(-1.3*age/${P.maxAge.toFixed(1)})*smoothstep(${P.maxAge.toFixed(1)},${(P.maxAge * 0.6).toFixed(2)},age);
  float d=hit*span*s*life*smoothstep(0.,${P.fadeIn.toFixed(1)},h0)
    *smoothstep(0.,.18,v.x)*smoothstep(1.,.82,v.x)*smoothstep(1.,.75,v.y);
  float a=clamp(d*uColor.a*${P.alpha.toFixed(2)},0.,1.);
  gl_FragColor=vec4(uColor.rgb*a,a);
}`;

  const wrap = (v: number) => ((v % 289) + 289) % 289;

  function parseColor(css: string) {
    const c = document.createElement('canvas').getContext('2d', { willReadFrequently: true })!;
    c.canvas.width = c.canvas.height = 1;
    c.fillStyle = 'rgb(255 255 255 / 0.5)';
    c.fillStyle = css;
    c.fillRect(0, 0, 1, 1);
    const [r, g, b, a] = c.getImageData(0, 0, 1, 1).data;
    return [r / 255, g / 255, b / 255, a / 255];
  }

  class Steam {
    root: HTMLElement;
    canvas: HTMLCanvasElement;
    box: { x: number; y: number; w: number; h: number };
    gl: WebGLRenderingContext | null = null;
    u: Record<string, WebGLUniformLocation | null> = {};
    color = [1, 1, 1, 0.5];
    raf = 0;
    visible = false;
    t = 0;
    last = 0;
    reduced = matchMedia('(prefers-reduced-motion: reduce)');

    constructor(root: HTMLElement) {
      this.root = root;
      this.canvas = root.querySelector('canvas')!;
      this.box = JSON.parse(root.dataset.box!);
      this.t = 20 + Math.random() * 200;
      this.canvas.addEventListener('webglcontextlost', e => { e.preventDefault(); this.gl = null; this.schedule(); });
      this.canvas.addEventListener('webglcontextrestored', () => { this.init(); this.schedule(); });
      if (!this.init()) return;
      new ResizeObserver(() => this.resize()).observe(this.canvas);
      new IntersectionObserver(([e]) => { this.visible = e.isIntersecting; this.schedule(); }).observe(this.canvas);
      document.addEventListener('visibilitychange', () => this.schedule());
      this.reduced.addEventListener('change', () => this.schedule());
    }

    init() {
      const gl = this.canvas.getContext('webgl', { antialias: false, depth: false, stencil: false, powerPreference: 'low-power' });
      if (!gl) { this.canvas.hidden = true; return false; }
      const prog = gl.createProgram()!;
      for (const [type, src] of [[gl.VERTEX_SHADER, VERT], [gl.FRAGMENT_SHADER, FRAG]] as const) {
        const s = gl.createShader(type)!;
        gl.shaderSource(s, src);
        gl.compileShader(s);
        gl.attachShader(prog, s);
      }
      gl.bindAttribLocation(prog, 0, 'a');
      gl.linkProgram(prog);
      if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) { this.canvas.hidden = true; return false; }
      gl.useProgram(prog);
      gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
      gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
      gl.enableVertexAttribArray(0);
      gl.vertexAttribPointer(0, 2, gl.FLOAT, false, 0, 0);
      for (const n of ['uBox', 'uColor', 'uScroll', 'uPhase', 'uRim']) this.u[n] = gl.getUniformLocation(prog, n);
      const b = this.box;
      gl.uniform4f(this.u.uBox, b.x, b.y, b.w, b.h);
      gl.uniform2f(this.u.uRim, P.rimY, P.x0);
      const css = getComputedStyle(this.root).getPropertyValue('--steam').trim();
      this.color = parseColor(css || 'rgb(255 255 255 / 0.5)');
      this.gl = gl;
      this.resize();
      return true;
    }

    resize() {
      const w = this.canvas.clientWidth, h = this.canvas.clientHeight;
      if (!w || !this.gl) return;
      const dpr = Math.min(P.maxDpr, devicePixelRatio || 1);
      this.canvas.width = Math.round(w * dpr);
      this.canvas.height = Math.round(h * dpr);
      this.gl.viewport(0, 0, this.canvas.width, this.canvas.height);
      this.draw(this.reduced.matches ? P.still : 1);
    }

    schedule() {
      const run = !!this.gl && this.visible && !document.hidden && !this.reduced.matches;
      if (run && !this.raf) { this.last = 0; this.raf = requestAnimationFrame(ts => this.frame(ts)); }
      if (!run && this.raf) { cancelAnimationFrame(this.raf); this.raf = 0; }
      if (this.reduced.matches) this.draw(P.still);
    }

    frame(ts: number) {
      this.raf = requestAnimationFrame(t => this.frame(t));
      this.t += this.last ? Math.min(0.1, (ts - this.last) / 1000) : 0;
      this.last = ts;
      this.draw(1);
    }

    draw(gain: number) {
      const gl = this.gl;
      if (!gl || !this.canvas.width) return;
      const t = this.t, s = P.eddySpeed * P.rise0;
      gl.uniform4f(this.u.uScroll, wrap(t * s / P.eddy0), wrap(t * s / P.eddy1), s / P.eddy0, wrap(t * 0.05));
      const tau = Math.PI * 2000;
      gl.uniform4f(this.u.uPhase, (t * 0.29) % tau, (t * 0.71) % tau, wrap(t * P.strandRate), wrap(t * 0.15));
      gl.uniform4f(this.u.uColor, this.color[0], this.color[1], this.color[2], this.color[3] * gain);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }
  }

  for (const root of document.querySelectorAll<HTMLElement>('.steam-logo')) new Steam(root);
</script>

<style>
  .steam-logo { position: relative; display: block; line-height: 0; }
  .steam-logo img { display: block; width: 100%; height: auto; }
  .steam {
    position: absolute;
    pointer-events: none;
    user-select: none;
  }
</style>
