---
import type { Tile } from './tiles';

interface Props { tile: Tile; size?: 'sm' | 'md' | 'lg' }
const { tile, size = 'md' } = Astro.props;

const glyphs: Record<string, string> = {
  deploy: 'M12 3v12M7 8l5-5 5 5M4 15v4h16v-4',
  screen: 'M3 5h18v11H3zM8 20h8M12 16v4',
  logs: 'M4 6h16M4 10h12M4 14h16M4 18h9',
  console: 'M4 7l5 5-5 5M11 17h9',
  pad: 'M6 9h12a4 4 0 0 1 4 4v1a3 3 0 0 1-5 2l-2-2H9l-2 2a3 3 0 0 1-5-2v-1a4 4 0 0 1 4-4zM8 11v4M6 13h4M16 12h.01M18 14h.01',
  api: 'M8 4C6 4 5 5 5 7v2l-2 3 2 3v2c0 2 1 3 3 3M16 4c2 0 3 1 3 3v2l2 3-2 3v2c0 2-1 3-3 3',
  reload: 'M20 12a8 8 0 1 1-2.3-5.7M20 4v5h-5',
  audio: 'M3 12h2M7 8v8M11 5v14M15 9v6M19 11v2',
  panel: 'M14 3h6v18h-6zM3 7h8M3 12h8M3 17h5',
};
---

{tile.kind === 'feature' && (
  <div class={`tile feature ${size}`} style={`--t:${tile.tone}`}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d={glyphs[tile.glyph]} /></svg>
    <strong>{tile.title}</strong>
    <span>{tile.sub}</span>
  </div>
)}
{tile.kind === 'log' && (
  <div class={`tile log ${size}`} aria-hidden="true">
    {tile.lines.map((l, i) => <code style={`opacity:${1 - i * 0.12}`}>{l}</code>)}
  </div>
)}
{tile.kind === 'code' && (
  <div class={`tile code ${size}`} aria-hidden="true">
    {tile.lines.map(l => <code>{l}</code>)}
  </div>
)}
{tile.kind === 'clip' && (
  <div class={`tile screen ${size}`} aria-hidden="true">
    <video muted loop playsinline preload="none" poster={tile.poster} data-webm={tile.webm} data-mp4={tile.mp4}></video>
  </div>
)}

<style>
  .tile {
    flex: none; width: 240px; height: 136px; border-radius: 12px; overflow: hidden; position: relative;
    box-shadow: 0 6px 20px rgb(0 0 0 / 0.28);
  }
  .tile.sm { width: 180px; height: 102px; }
  .tile.lg { width: 300px; height: 170px; }
  .feature {
    display: flex; flex-direction: column; justify-content: flex-end; gap: 2px; padding: 14px 16px; color: var(--hero-text);
    background: linear-gradient(135deg, hsl(var(--hue) var(--tile-sat) calc(var(--tile-light) + var(--t) * 5%)), hsl(var(--hue) calc(var(--tile-sat) + 12%) calc(var(--tile-dark) + var(--t) * 3%)));
    border: 1px solid rgb(255 255 255 / 0.08);
  }
  .feature svg {
    position: absolute; top: 12px; left: 14px; width: 30px; height: 30px; fill: none; stroke: var(--hero-text);
    stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; opacity: 0.95;
  }
  .feature strong { font-size: 1rem; line-height: 1.2; }
  .feature span { font-size: 0.78rem; opacity: 0.85; }
  .sm.feature strong { font-size: 0.86rem; }
  .sm.feature svg { width: 22px; height: 22px; }
  .log, .code {
    display: flex; flex-direction: column; justify-content: center; gap: 4px; padding: 12px 14px;
    background: var(--tile-surface); border: 1px solid var(--tile-border);
  }
  .log code, .code code { font: 0.74rem/1.3 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; white-space: nowrap; }
  .log code { color: var(--tile-log); }
  .code code { color: var(--tile-code); }
  .code code:last-child { color: var(--tile-comment); }
  .screen { background: var(--tile-surface); border: 1px solid var(--tile-border); }
  .screen video { width: 100%; height: 100%; object-fit: cover; object-position: left top; display: block; }
</style>
